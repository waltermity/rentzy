POSTGRES_USER=rentzy
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rentzy

DATABASE_URL=postgres://rentzy:change_me@localhost:5432/rentzy?sslmode=disable
PORT=8080
# JWT signing key (HS256), at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_32+
# Optional (defaults shown)
JWT_TTL=24h
RESERVATION_GRACE_HOURS=24
STATUS_REFRESH_INTERVAL=1m
